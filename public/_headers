# Cloudflare Pages response headers. Static export can't emit a next.config
# headers() block, so the baseline security headers live here and apply to every
# path: clickjacking, MIME sniffing, and referrer leakage. (No CSP — the inline
# theme-init script would need a per-request nonce/hash, and a misconfigured CSP
# failing closed is a worse risk than its marginal benefit on a static site.)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Everything under /_next/static/ has a content hash in its filename, so a new
# build always emits a new URL — the bytes at a given URL never change. Cache them
# for a year and skip revalidation, instead of Cloudflare's 4-hour default that
# re-checks ~220 KB of JS on every field reload. The HTML that references these
# names stays max-age=0/must-revalidate, so a deploy is still picked up instantly.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Public conditions API (docs at /api). Free, read-only JSON, CORS-enabled so anything can consume
# it; cached ~5 min at the edge/browser (well under the hourly refresh, so a reader never sees data
# older than one cycle). Served as plain static assets — no Workers/KV, unmetered.
/api/v1/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# The GeoJSON view gets the proper media type so mapping tools recognise it (the CORS + cache
# headers above still apply — Cloudflare merges all matching _headers rules).
/api/v1/*.geojson
  Content-Type: application/geo+json
