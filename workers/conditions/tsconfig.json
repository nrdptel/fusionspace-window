{
  // Standalone config for the Worker (bundled by wrangler/esbuild, not the Next build). It reaches
  // up into ../../../lib for the shared, tested wind logic.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["src/**/*.ts", "../../lib/weather/sitefeed.ts", "../../lib/launchSites.ts", "../../lib/weather/limits.ts"]
}
