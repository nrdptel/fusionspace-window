{
  // Cloudflare Worker: the "all sites" conditions feed. Deployed by
  // .github/workflows/deploy-worker.yml with the same Cloudflare token the site uses.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fusionspace-window-conditions",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",

  // Every 15 minutes. Open-Meteo's model data only refreshes hourly, so 15 min keeps the feed
  // fresh (catching each new model run and advancing the current-hour snapshot) without polling
  // for the sake of it. Free tier easily covers this; drop to "*/30 * * * *" to be even lighter.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // KV holds the single latest feed (one key). Create the namespace once and paste its id here:
  //   npx wrangler kv namespace create CONDITIONS
  // then replace REPLACE_WITH_KV_NAMESPACE_ID below with the printed id. See docs/design-notes.md
  // ("All-sites conditions feed") for the full one-time setup.
  "kv_namespaces": [
    {
      "binding": "CONDITIONS",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],

  // Serve on the free *.workers.dev subdomain (the site fetches this URL). Set a custom route/domain
  // later if you want it under the site's own domain.
  "workers_dev": true,
  "observability": { "enabled": true }
}
